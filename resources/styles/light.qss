/* Light Theme for Battery Manager Pro */

/* Main Window */
QMainWindow {
    background-color: #ffffff;
    color: #000000;
}

/* General Widget Styling */
QWidget {
    background-color: #ffffff;
    color: #000000;
    font-family: "Ubuntu", "Segoe UI", Arial, sans-serif;
    font-size: 11pt;
}

/* Group Box */
QGroupBox {
    background-color: #f5f5f5;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    margin-top: 12px;
    padding: 15px;
    font-weight: bold;
    color: #0d7377;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 5px 10px;
    color: #0d7377;
    font-size: 12pt;
}

/* Labels */
QLabel {
    background-color: transparent;
    color: #2d2d2d;
    padding: 2px;
}

/* Buttons */
QPushButton {
    background-color: #0d7377;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #14919b;
}

QPushButton:pressed {
    background-color: #0a5d61;
}

QPushButton:disabled {
    background-color: #e0e0e0;
    color: #a0a0a0;
}

/* Radio Buttons */
QRadioButton {
    color: #2d2d2d;
    spacing: 8px;
    padding: 5px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid #0d7377;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    background-color: #0d7377;
    border: 2px solid #14919b;
}

QRadioButton::indicator:hover {
    border: 2px solid #14919b;
}

/* Check Boxes */
QCheckBox {
    color: #2d2d2d;
    spacing: 8px;
    padding: 5px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #0d7377;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #0d7377;
    border: 2px solid #14919b;
}

QCheckBox::indicator:hover {
    border: 2px solid #14919b;
}

/* Progress Bar */
QProgressBar {
    background-color: #f5f5f5;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    text-align: center;
    color: #2d2d2d;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #0d7377;
    border-radius: 3px;
}

/* Scroll Bar */
QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #0d7377;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #14919b;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Menu Bar */
QMenuBar {
    background-color: #f5f5f5;
    color: #000000;
    border-bottom: 1px solid #d0d0d0;
}

QMenuBar::item {
    background-color: transparent;
    padding: 8px 12px;
}

QMenuBar::item:selected {
    background-color: #0d7377;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #d0d0d0;
}

QMenu::item {
    padding: 8px 20px;
}

QMenu::item:selected {
    background-color: #0d7377;
    color: #ffffff;
}

/* Status Bar */
QStatusBar {
    background-color: #f5f5f5;
    color: #2d2d2d;
    border-top: 1px solid #d0d0d0;
}

/* Tool Tip */
QToolTip {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #0d7377;
    border-radius: 4px;
    padding: 5px;
}

/* Spin Box */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 5px;
    color: #000000;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: #0d7377;
    border-radius: 2px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #0d7377;
    border-radius: 2px;
}

/* Combo Box */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 5px;
    color: #000000;
}

QComboBox:hover {
    border: 1px solid #0d7377;
}

QComboBox::drop-down {
    border: none;
    background-color: #0d7377;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #000000;
    selection-background-color: #0d7377;
    selection-color: #ffffff;
    border: 1px solid #d0d0d0;
}
